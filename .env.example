# DB
POSTGRES_DB=AegisVision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# API 인증 - 콤마로 여러 클라이언트 키 등록, "키=클라이언트이름" 형식 권장
# 감사 로그(audit_logs)에서 client_name으로 구분해서 조회할 수 있음
API_KEYS=control-center-key-here=관제센터,sensor-gw01-key-here=센서게이트웨이1

# HTTPS (Caddy가 자동으로 Let's Encrypt 인증서를 발급받을 도메인)
DOMAIN=example.duckdns.org

# JWT (사람이 로그인하는 대시보드/관리 기능용)
# 운영 배포 전 반드시 openssl rand -hex 32 등으로 새로 생성해서 교체할 것
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# 컨테이너 최초 기동 시 자동 생성되는 관리자 계정 (이후엔 DB에서 직접 관리)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=changeme123
