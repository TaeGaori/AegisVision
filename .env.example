# ===== 사용법 =====
# 이 파일을 복사해서 .env 를 만들고, change-me 로 된 값을 모두 직접 만든 값으로 바꾸세요.
#   cp .env.example .env
# .env 는 git 에 올리지 않습니다 (.gitignore 확인).
# 비밀번호/키 생성 예: openssl rand -hex 24

# ===== DB =====
# uvicorn 을 로컬에서 직접 실행할 때 쓰는 주소입니다.
# docker-compose 에서는 api 컨테이너의 DATABASE_URL 이 호스트 db 로 자동 덮어쓰기 됩니다.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/AegisVision
POSTGRES_DB=AegisVision
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ===== API 인증 =====
# 서버가 허용하는 키 목록입니다. "키=클라이언트이름" 을 콤마로 연결합니다 (콤마 앞뒤 공백 없음).
# 감사 로그(audit_logs)에서 client_name 으로 어느 화면이 호출했는지 구분됩니다.
API_KEYS=change-me-streamlit-key=streamlit-dashboard,change-me-react-key=react-dashboard

# Streamlit 이 요청에 사용하는 키입니다. API_KEYS 의 streamlit-dashboard 키와 같은 값이어야 합니다.
STREAMLIT_API_KEY=change-me-streamlit-key

# React 가 요청에 사용하는 키입니다. API_KEYS 의 react-dashboard 키와 같은 값이어야 합니다.
# docker-compose 로 빌드할 때 화면 코드에 포함됩니다.
REACT_API_KEY=change-me-react-key

# ===== 관리자 계정 =====
# 컨테이너 최초 기동 시 자동 생성되는 관리자 계정입니다 (이후에는 DB 에서 직접 관리).
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# ===== JWT (사람이 로그인하는 기능용) =====
# 운영 배포 전 반드시 openssl rand -hex 32 로 새로 만들어 교체하세요.
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60

# ===== HTTPS (Caddy 사용 시) =====
# DOMAIN=example.duckdns.org